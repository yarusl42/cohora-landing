# Canonical production URL. It defaults to https://cohora.org.
# Set this only for a deployment that has a different public canonical domain.
NEXT_PUBLIC_SITE_URL=https://cohora.org
NEXT_PUBLIC_SENTRY_DSN=

# Replace these before publishing the legal pages.
COHORA_LEGAL_PROVIDER_NAME=Cohora
COHORA_LEGAL_BUSINESS_ADDRESS=Israel
COHORA_SUPPORT_EMAIL=support@cohora.org
COHORA_PRIVACY_EMAIL=privacy@cohora.org
